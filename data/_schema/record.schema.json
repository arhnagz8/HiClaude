{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiclaude.local/schema/record.schema.json",
  "title": "Perishable fact record",
  "description": "Every leaf fact in data/*.json is a Record. Values are perishable: always carry as_of and sources.",
  "type": "object",
  "required": ["value", "as_of", "confidence"],
  "properties": {
    "value": { "type": ["number", "string", "boolean", "null", "array", "object"] },
    "unit": { "type": "string", "description": "e.g. USD, USDT, IRT, pct, hours, days, count" },
    "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "confidence": { "enum": ["high", "medium", "low"] },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string" },
          "title": { "type": "string" },
          "note": { "type": "string", "description": "e.g. 'per search summary' when the page was not directly seen" }
        }
      }
    },
    "verify_how": { "type": "string", "description": "Exact steps the owner/implementer takes to confirm this fact first-hand" },
    "status": { "enum": ["verified", "reported", "UNVERIFIED", "conflicting"] },
    "note": { "type": "string" }
  },
  "additionalProperties": true
}
